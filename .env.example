# ==============================================================================
# TEMPLATE — this file is committed to git. Never put real keys in it.
#
#   Linux / macOS:  cp .env.example .env
#   Windows:        copy .env.example .env
#
# Then edit .env, which is gitignored.
#
# FOR A LOCAL DEMO you need exactly ONE key: GROQ_API_KEY.
# Set LOCAL_MODE=true and skip everything under "Cloud mode".
# ==============================================================================

# --- REQUIRED IN EVERY MODE --------------------------------------------------
# console.groq.com/keys — free, no card needed.
# Serves the guardrail classifier (llama-3.1-8b-instant) and, in local mode,
# answer generation (llama-3.3-70b-versatile).
GROQ_API_KEY=

# --- LOCAL MODE --------------------------------------------------------------
# true  → embedded Qdrant on disk, sentence-transformers embeddings (768-dim),
#         direct Groq calls. One key, no accounts.
# false → Qdrant Cloud, Gemini embeddings (3072-dim), Portkey gateway.
#
# Local mode exercises the same graph, guardrails, and two-stage reranker.
# What it gives up: the gateway's 70B→8B fallback, response cache, and retry.
# /health reports which mode is active so there is no ambiguity at demo time.
LOCAL_MODE=true

# Where embedded Qdrant stores its vector data. Created on first ingest.
# Gitignored — never commit this directory.
QDRANT_LOCAL_PATH=.qdrant_local

# ==============================================================================
# CLOUD MODE — only needed when LOCAL_MODE=false
# ==============================================================================

# --- LLM gateway (Portkey) ---------------------------------------------------
# app.portkey.ai — routes generation, provides 70B→8B fallback, response cache,
# and retry-on-429. Create two virtual keys in the Portkey dashboard:
#   PORTKEY_PRIMARY_SLUG  → holds your main Groq key
#   PORTKEY_FALLBACK_SLUG → holds a DIFFERENT Groq key (sharing one defeats fallback)
PORTKEY_API_KEY=
PORTKEY_PRIMARY_SLUG=rag
PORTKEY_FALLBACK_SLUG=brag
GROQ_FALLBACK_API_KEY=

# --- Vector database (Qdrant Cloud) ------------------------------------------
# cloud.qdrant.io — free 1 GB cluster.
# Endpoint must include scheme AND port, e.g.
#   https://your-cluster-id.us-west-2-0.aws.cloud.qdrant.io:6333
# Omitting :6333 is a common cause of connection failures.
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=

# --- Embeddings (Gemini) -----------------------------------------------------
# aistudio.google.com/apikey — free tier.
# Switching between local and cloud mode changes vector width (768 ↔ 3072),
# so you must re-index with --wipe after toggling LOCAL_MODE.
GEMINI_API_KEY=

# ==============================================================================
# OPTIONAL — everything below can stay blank; the app runs fine without it
# ==============================================================================

# --- Model overrides ---------------------------------------------------------
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_GUARD_MODEL=llama-3.1-8b-instant
# GEMINI_EMBED_MODEL=models/gemini-embedding-2-preview
# LOCAL_EMBED_MODEL=all-mpnet-base-v2
# QDRANT_COLLECTION=enterprise_rag

# --- Mix modes independently -------------------------------------------------
# Each defaults to whatever LOCAL_MODE implies. Override only if you want, e.g.,
# cloud Qdrant with local embeddings.
# USE_LOCAL_QDRANT=
# USE_LOCAL_EMBEDDINGS=
# USE_GATEWAY=

# --- Observability -----------------------------------------------------------
# logfire.pydantic.dev — distributed tracing UI. App runs fine without it.
LOGFIRE_TOKEN=

# smith.langchain.com — per-step LangGraph tracing. Optional.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=enterprise-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Service wiring ----------------------------------------------------------
# Where the UI and eval suite look for the API.
# scripts/demo.py sets BACKEND_URL itself.
BACKEND_URL=http://localhost:8000

# Shared secret for POST /query, sent as the X-API-Key header.
# Blank disables the check — fine locally. Set a strong random value before
# any public deployment: openssl rand -hex 32
API_KEY=

# Comma-separated origins allowed to call the API from a browser.
# The Streamlit UI calls server-side and does not need CORS.
ALLOWED_ORIGINS=

# --- Evaluation --------------------------------------------------------------
# A second Groq key so the eval suite cannot exhaust the rate limit the live app
# depends on. Falls back to GROQ_API_KEY when blank.
JUDGE_GROQ=
