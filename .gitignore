# --- Corpus ---
# DATA/true_data/ IS tracked — it is small (~3 MB) and is the knowledge base the
# golden dataset is written against, so the eval suite is reproducible from a
# fresh clone.
#
# DATA/noisy_data/ is NOT tracked: ~97 MB of third-party PDFs (Intel manuals, ACM
# papers, conference slides) that are not ours to redistribute. See
# DATA/noisy_data/MANIFEST.md to reconstruct it.
DATA/noisy_data/
!DATA/noisy_data/MANIFEST.md
!DATA/noisy_data/README.txt

# --- Generated artefacts ---
# Rebuildable with: python -m app.ingestion.processor DATA --wipe
processed_data/

# Embedded Qdrant store used by the local demo — regenerated by ingestion
.qdrant_local/

# Eval run outputs
evals/results/
evals/*_results.json

# --- Caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.logfire/

# --- Local vector store (legacy FAISS experiments) ---
index.faiss
metadata.pkl

